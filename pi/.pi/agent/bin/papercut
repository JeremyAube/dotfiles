#!/usr/bin/env bash
# Log workflow friction to ~/.pi/agent/papercuts.md
# Usage: papercut "<what you hit and what would have prevented it>" [area]

set -euo pipefail

usage() {
	cat <<'EOF'
Usage: papercut "<friction>" [area]

Areas: tooling, docs, env, commands, other

Example:
  papercut "yarn test from repo root finds no files; cwd must be apps/web" tooling
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
	usage
	[[ $# -eq 0 ]] && exit 2
	exit 0
fi

friction=$1
area=${2:-}

if [[ -z "${friction//[[:space:]]/}" ]]; then
	echo "papercut: friction text is required" >&2
	exit 2
fi

if [[ -n "$area" && ! "$area" =~ ^(tooling|docs|env|commands|other)$ ]]; then
	echo "papercut: unknown area '$area' (tooling|docs|env|commands|other)" >&2
	exit 2
fi

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
file="$agent_dir/papercuts.md"
cwd=$(pwd -P)
stamp=$(date '+%Y-%m-%d %H:%M')

repo=""
branch=""
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
	repo=$(basename "$top")
	branch=$(git branch --show-current 2>/dev/null || true)
fi

model=""
if [[ -n "${PI_PROVIDER:-}" && -n "${PI_MODEL:-}" ]]; then
	model="$PI_PROVIDER/$PI_MODEL"
fi

if [[ -n "$area" ]]; then
	heading="$stamp · $area"
else
	heading="$stamp"
fi

{
	printf '## %s\n\n%s\n\n' "$heading" "$friction"
	printf -- '- cwd: `%s`\n' "$cwd"
	if [[ -n "$repo" ]]; then
		if [[ -n "$branch" ]]; then
			printf -- '- repo: `%s @ %s`\n' "$repo" "$branch"
		else
			printf -- '- repo: `%s`\n' "$repo"
		fi
	fi
	if [[ -n "$model" ]]; then
		printf -- '- model: `%s`\n' "$model"
	fi
	printf '\n'
} | {
	umask 077
	mkdir -p "$agent_dir"
	if [[ ! -f "$file" ]]; then
		printf '# Papercuts\n\nPrivate friction log. Agents append; you review.\n\n' >"$file"
	fi
	cat >>"$file"
}

echo "Logged papercut."
